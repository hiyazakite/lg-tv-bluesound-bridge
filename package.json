{
  "name": "lg-tv-bluesound-bridge",
  "version": "1.0.1",
  "private": true,
  "description": "Keep an LG webOS TV's volume in step with a Bluesound (BluOS) player",
  "main": "bridge.js",
  "scripts": {
    "test": "node --test test/unit.test.js test/client.test.js test/integration.test.js",
    "test:watch": "node --test --watch test/unit.test.js test/client.test.js test/integration.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 test/unit.test.js test/client.test.js test/integration.test.js",
    "test:device": "sh test/device/run.sh",
    "test:device:writes": "sh test/device/run.sh --allow-writes",
    "test:device:installed": "sh test/device/run.sh --allow-writes --installed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiyazakite/lg-tv-bluesound-bridge.git"
  },
  "homepage": "https://github.com/hiyazakite/lg-tv-bluesound-bridge#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
